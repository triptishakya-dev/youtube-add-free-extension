{
  "manifest_version": 3,
  "name": "YouTube Ad Guard",
  "version": "0.2.0",
  "description": "YouTube-focused request filtering with adaptive page and player ad handling.",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "youtube_ad_rules",
        "enabled": true,
        "path": "rules/youtube-ad-rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": [
        "content/youtube-detector.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/youtube-ad-blocker.png",
      "32": "icons/youtube-ad-blocker.png",
      "48": "icons/youtube-ad-blocker.png",
      "128": "icons/youtube-ad-blocker.png"
    }
  },
  "icons": {
    "16": "icons/youtube-ad-blocker.png",
    "32": "icons/youtube-ad-blocker.png",
    "48": "icons/youtube-ad-blocker.png",
    "128": "icons/youtube-ad-blocker.png"
  }
}
